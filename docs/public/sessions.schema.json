{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urzahil.github.io/ConfNav/sessions.schema.json",
  "title": "ConfNav sessions file",
  "description": "Format shared by the ConfNav Android app and the web builder. The file is either an array of sessions, or an object { \"sessions\": [...] }. Unknown properties are preserved by the web builder and ignored by the app.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/session" } },
    {
      "type": "object",
      "required": ["sessions"],
      "properties": { "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } } }
    }
  ],
  "$defs": {
    "session": {
      "type": "object",
      "required": ["title", "date", "startTime", "endTime"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string", "description": "Defaults to \"TBD\" when empty." },
        "speakerRole": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{1,2}-\\d{1,2}$", "description": "YYYY-MM-DD, a real calendar date." },
        "startTime": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "description": "24-hour HH:mm." },
        "endTime": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "description": "24-hour HH:mm, must be after startTime." },
        "locationName": { "type": "string", "description": "Sessions with the same name share one map pin and colour." },
        "address": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "colorHex": { "type": "string", "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$" },
        "track": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
